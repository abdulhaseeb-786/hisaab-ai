# Backend the Vite dev server forwards /api and /static to.
BACKEND_URL=http://127.0.0.1:8000

# Only for a deployed build: the backend's public URL (leave empty in development).
VITE_API_BASE_URL=

# Must match DEMO_RESET_KEY in backend/.env (used by the "Reset demo" button).
VITE_DEMO_RESET_KEY=cye2026
