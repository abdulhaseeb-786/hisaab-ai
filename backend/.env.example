# HisaabAI Hackathon Backend Environment Configuration
ENVIRONMENT=development
DATABASE_URL=sqlite:///./hisaab_ai.db
DEBUG=True

# Store Defaults
STORE_NAME=Al-Madina General Store
STORE_CURRENCY=PKR
DEFAULT_CREDIT_TERM_DAYS=30

# LLM Providers (Multi-tier fallback: Gemini -> Groq -> Offline Deterministic)
GEMINI_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_PROVIDER=gemini
