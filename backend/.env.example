# Copy to .env. Every setting is optional; the defaults run the demo.

# Database (a relative SQLite path is resolved against the backend folder)
DATABASE_URL=sqlite:///./hisaab_ai.db

# Demo store
STORE_NAME=Al-Madina General Store
STORE_LOCATION=G-9 Markaz, Islamabad
STORE_OWNER=Haji Muhammad Akram
DEFAULT_CREDIT_TERM_DAYS=30
DEMO_DATA_SEED=42
DEMO_HISTORY_DAYS=365
# Rebuild the demo data on startup when it is missing, from an old schema, or not from today
DEMO_AUTO_REFRESH=true
# Key the "Reset demo" button sends (frontend VITE_DEMO_RESET_KEY must match)
DEMO_RESET_KEY=cye2026

# Comma-separated allowed origins for CORS ("*" is fine for local use)
CORS_ORIGINS=*

# Copilot: "auto" tries Gemini, then Groq, then the offline engine; "offline" never calls an LLM
COPILOT_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=20
